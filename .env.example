# =============================================================================
# dARK Core Minter API - Configuration Template
# =============================================================================

# -- API Server Defaults --
MINTER_API_HOST=0.0.0.0
MINTER_API_PORT=8001
MINTER_API_WORKERS=2

# -- Blockchain Connection --
DARK_RPC_URL=http://localhost:8545
DARK_RPC_HEALTH_TIMEOUT_SECONDS=2.0
DARK_RPC_CONNECT_RETRY_SECONDS=30.0
DARK_RPC_CONNECT_RETRY_INTERVAL_SECONDS=2.0
DARK_CHAIN_ID=1337
DARK_GAS_LIMIT=550000

# -- Contract Addresses --
DARK_AUTHORITY_ADDRESS=0xb9A219631Aed55eBC3D998f17C3840B7eC39C0cc
DARK_CONTRACT_ADDRESS=0x4D2D24899c0B115a1fce8637FCa610Fe02f1909e

# -- Admin Credentials --
# Required for blockchain writes through dark-core-lib
DARK_ADMIN_PRIVATE_KEY=0xae6ae8e5ccbfb04590405997ee2d52d2b330726137b875053c36d94e974d162f

# -- Minter Specific --
# DARK 2 shoulder: 2 = DARK version; final two digits identify this minter.
# Assign a unique code per minter for each NAAN. 200 is the default allocation.
# Generated-part length is currently operated as fixed (recommended: 7)
MINTER_SHOULDER=200
MINTER_NOID_LENGTH=7
MINTER_NOID_CHECKDIGIT=true
BATCH_SIZE_LIMIT=100

# -- Database --
# PostgreSQL (recommended for all environments)
DB_PASSWORD=dark_password
DATABASE_URL=postgresql://dark:dark_password@localhost:5433/minter
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# -- Authorization Cache --
AUTH_CACHE_TTL=60
AUTH_CACHE_MAXSIZE=1000

# -- Worker Configuration --
METADATA_WORKER_ENABLED=true
METADATA_WORKER_PAGE_SIZE=100
METADATA_WORKER_CONCURRENCY=4
METADATA_WORKER_MIN_CONCURRENCY=2
METADATA_WORKER_SLEEP_SECONDS=2
METADATA_WORKER_STORAGE_RETRY_SECONDS=10
METADATA_WORKER_MAX_RETRIES=5
METADATA_WORKER_RETRY_BACKOFF_BASE=2.0
METADATA_WORKER_RUNTIME_NAME=metadata-publisher
REPLICATION_WORKER_ENABLED=true
REPLICATION_WORKER_PAGE_SIZE=100
REPLICATION_WORKER_CONCURRENCY=2
REPLICATION_WORKER_SLEEP_SECONDS=2
REPLICATION_STATUS_BATCH_SIZE=200
REPLICATION_PROMOTION_BATCH_SIZE=100
REPLICATION_PROMOTION_PRESSURE_HIGH_PERCENT=80
REPLICATION_PROMOTION_PRESSURE_MEDIUM_PERCENT=50
REPLICATION_PROMOTION_MIN_BATCH_SIZE=20
WORKER_MAX_IDLE_SLEEP_SECONDS=10
REPLICATION_MAINTENANCE_CYCLE_SECONDS=5
REPLICATION_IDLE_SLEEP_SECONDS=2
REPLICATION_WORKER_STORAGE_RETRY_SECONDS=10
REPLICATION_WORKER_RUNTIME_NAME=replication-reconciler
REPLICATION_PUBLISH_AFTER_REPLICAS=1
REPLICATION_TARGET_REPLICAS=2
REPLICATION_FIRST_PIN_RECHECK_SECONDS=15
REPLICATION_FIRST_PIN_SECOND_RECHECK_SECONDS=60
REPLICATION_FIRST_PIN_MAX_RECHECK_SECONDS=300
REPLICATION_DURABILITY_RECHECK_SECONDS=300
REPLICATION_DURABILITY_SECOND_RECHECK_SECONDS=900
REPLICATION_DURABILITY_MAX_RECHECK_SECONDS=3600
CHAIN_WORKER_ENABLED=true
CHAIN_WORKER_PAGE_SIZE=100
CHAIN_WORKER_RPC_BATCH_SIZE=50
CHAIN_WORKER_SLEEP_SECONDS=5
CHAIN_WORKER_RPC_RETRY_SECONDS=10
CHAIN_WORKER_CONGESTION_RETRY_SECONDS=30
CHAIN_WORKER_BLOCK_STALL_SECONDS=120
CHAIN_WORKER_ADAPTIVE_PAGE_ENABLED=true
CHAIN_WORKER_MIN_PAGE_SIZE=1
CHAIN_WORKER_HEALTHY_CYCLES_BEFORE_GROWING=3
CHAIN_WORKER_MAX_RETRIES=5
CHAIN_WORKER_RETRY_BACKOFF_BASE=2.0
CHAIN_WORKER_RUNTIME_NAME=chain-publisher

# Worker heartbeat settings.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=180

# -- Metadata Storage --
METADATA_STORAGE_TYPE=store_api
METADATA_STORAGE_PATH=./metadata_storage
METADATA_STORE_API_URL=http://localhost:8003
METADATA_STORE_API_TIMEOUT_SECONDS=10.0

# -- Security (mTLS) --
MTLS_ENABLED=false
# When mTLS is disabled, mutating endpoints require X-Authority-Id
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
# TLS_CA_FILE=./certs/ca.crt
