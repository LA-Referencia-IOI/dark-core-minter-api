# =============================================================================
# dARK Core Minter API - Configuration Template
# =============================================================================

# -- API Server Defaults --
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8001

# -- Blockchain Connection --
DARK_RPC_URL=http://localhost:8545
DARK_CHAIN_ID=1337

# -- Contract Addresses --
DARK_AUTHORITY_ADDRESS=0xb9A219631Aed55eBC3D998f17C3840B7eC39C0cc
DARK_CONTRACT_ADDRESS=0x4D2D24899c0B115a1fce8637FCa610Fe02f1909e

# -- Admin Credentials --
# Required for Orchestrator initialization and key decryption
DARK_ADMIN_PRIVATE_KEY=0xae6ae8e5ccbfb04590405997ee2d52d2b330726137b875053c36d94e974d162f

# -- Minter Specific --
# Shoulder for ARK generation (e.g. 'x', 's', or empty)
MINTER_SHOULDER=x
BATCH_SIZE_LIMIT=100

# -- Security (mTLS) --
MTLS_ENABLED=false
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
# TLS_CA_FILE=./certs/ca.crt
