# =============================================================================
# dARK Core API Configuration
# =============================================================================

# API Server
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8001

# Batch processing limits
BATCH_SIZE_LIMIT=100

# =============================================================================
# mTLS Configuration
# =============================================================================
# Set to "true" to require client certificates
MTLS_ENABLED=false

# Paths to TLS certificates (required when MTLS_ENABLED=true)
TLS_CERT_FILE=/path/to/server.crt
TLS_KEY_FILE=/path/to/server.key
TLS_CA_FILE=/path/to/ca.crt

# =============================================================================
# Blockchain Connection (same as dark-orchestrator)
# =============================================================================
DARK_RPC_URL=http://localhost:8545
DARK_CHAIN_ID=1337

# Contract Addresses (update from dark-dapp/deployed_contracts.ini)
DARK_AUTHORITY_ADDRESS=0x...
DARK_CONTRACT_ADDRESS=0x...

# Admin Account (deployer key)
DARK_ADMIN_PRIVATE_KEY=0x...
